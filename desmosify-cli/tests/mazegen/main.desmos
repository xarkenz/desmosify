// This block contains the top-level items for the graph
// Everything else will be hidden in folders
public {
    "Welcome to the maze generator!";
    "";
    "Press reset to clear the screen:";
    action reset();
    "";
    "Press generate to generate a new maze:";
    action generate(10, 10);
}

// Ticker action
ticker = action step;

enum State {
    IDLE,
    GENERATING,
}

enum Tile {
    WALL,
    AIR,
}

var state: State = State.IDLE;
var maze_w: int = 0;
var maze_h: int = 0;
var grid: [(int, int)] = [];
var maze: [Tile] = [];
var gen_stack: [(int, int)] = [];

let gen_pos: (int, int) = gen_stack[@count(gen_stack)];
let gen_options: [(int, int)] = []; // TODO
let gen_dir: (int, int) = (0, 0); // TODO

let grid_list(width: int, height: int): [(int, int)] = [
    (x, y)
    for x in [0 ..< width]
    for y in [0 ..< height]
];

action reset() {
    state := State.IDLE,
    maze_w := 0,
    maze_h := 0,
    grid := [],
    maze := [],
}

action generate(w: int, h: int) {
    state := State.GENERATING,
    maze_w := 2 * w + 1,
    maze_h := 2 * h + 1,
    grid := grid_list(2 * w + 1, 2 * h + 1),
    maze := [
        {(x == 1 && y == 2*h - 1) || (x == 2*w && y == 1): Tile.AIR, Tile.WALL}
        for x in [0 ..= 2*w]
        for y in [0 ..= 2*h]
    ],
    gen_stack := [(-1, 2*h - 1), (1, 2*h - 1)],
}

action step() {
    if state == State.GENERATING && @count(gen_stack) > 1 then {
        if @count(gen_options) > 0 then {
            maze := {grid == gen_pos + gen_dir || grid == gen_pos + 2 * gen_dir: Tile.AIR, maze},
            gen_stack := @join(gen_stack, gen_pos + 2 * gen_dir),
        }
        else {
            gen_stack := gen_stack[[1 ..< @count(gen_stack)]],
        },
    }
    else {
        state := State.IDLE,
    },
}
