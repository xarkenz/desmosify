enum Mode {
    Initial,
    Play,
    Win,
    Loss,
    Cheated,
}

enum Tile {
    Empty,
    One,
    Two,
    Three,
    Four,
    Five,
    Six,
    Seven,
    Eight,
    Mine,
}

enum TileState {
    Hidden,
    Revealed,
    Flagged,
}

enum ControlScheme {
    Halves,
    DoubleClick,
}

// Configuration variables

var slider(2 ..= 40) board_width: int = 18;
var slider(2 ..= 40) board_height: int = 14;
var slider(1 ..= current_width * current_height - 1) mine_count: int = 40;
// TODO: make the slider range the default here lol this is annoying
var slider(ControlScheme.Halves ..= ControlScheme.DoubleClick) control_scheme: ControlScheme = ControlScheme.Halves;
var view_mode: bool = false;
var slider(0.5 ..= 5 : 0.25) double_click_max_delay: real = 2;
var slider(0 ..= 2.5 : 0.25) border_units: real = 0.5;

// Variables

var mode: Mode = Mode.Initial;
var current_width: int = 18;
var current_height: int = 14;
var tiles: [Tile] = [Tile.Empty; 18 * 14];
var tile_states: [TileState] = [TileState.Hidden; 18 * 14];
var spread_indices: [int] = [];

// Definitions

let grid: [(int, int)] = [
    (x, y)
    for y in [0 ..< current_height]
    for x in [0 ..< current_width]
];

let populate_tiles(initial_tiles: [Tile]): [Tile] = [
    {
        initial_tiles[index] == Tile.Mine: Tile.Mine,
        @enum_value(Tile, count_adjacent_mines(initial_tiles, index))
    }
    for index in [1 ..= @count(initial_tiles)]
];

let count_adjacent_mines(tiles: [Tile], index: int): int =
    let has_left = index % current_width != 1 in
    let has_right = index % current_width != 0 in
    let has_down = index > current_width in
    let has_up = index <= @count(tiles) - current_width in
    (has_left && tiles[index - 1] == Tile.Mine) +
    (has_right && tiles[index + 1] == Tile.Mine) +
    (has_down && tiles[index - current_width] == Tile.Mine) +
    (has_up && tiles[index + current_width] == Tile.Mine) +
    (has_left && has_down && tiles[index - 1 - current_width] == Tile.Mine) +
    (has_left && has_up && tiles[index - 1 + current_width] == Tile.Mine) +
    (has_right && has_down && tiles[index + 1 - current_width] == Tile.Mine) +
    (has_right && has_up && tiles[index + 1 + current_width] == Tile.Mine);

let is_adjacent_to_any(test_index: int, indices: [int]): bool = @any([
    @max(@abs(grid[test_index].x - grid[index].x), @abs(grid[test_index].y - grid[index].y)) <= 1
    for index in indices
]);

let is_solved(test_tile_states: [TileState]): bool = @all({
    tiles == Tile.Mine: test_tile_states == TileState.Flagged,
    test_tile_states == TileState.Revealed
});

// Utilities

let set_item(list: [any], index: int, value: any): [any] = {
    [1 ..= @count(list)] == index: value,
    list
};
let insert_item(list: [any], index: int, value: any): [any] = @join(
    list[..< index],
    value,
    list[index ..],
);

// Actions

action easy_preset() {
    action preset(10, 8, 10),
}

action medium_preset() {
    action preset(18, 14, 40),
}

action hard_preset() {
    action preset(24, 20, 99),
}

action preset(width: int, height: int, count: int) {
    board_width := width,
    board_height := height,
    mine_count := count,
}

action reset() {
    mode := Mode.Initial,
    current_width := board_width,
    current_height := board_height,
    tiles := [Tile.Empty; board_width * board_height],
    tile_states := [TileState.Hidden; board_width * board_height],
}

ticker = action tick;

action update_tile_states(new_tile_states: [TileState]) {
    tile_states := new_tile_states,
    if is_solved(new_tile_states) then {
        mode := Mode.Win,
        end_anim_timer := 0,
    },
}

let is_spread_reveal_tile: [bool] = tile_states == TileState.Hidden && [
    is_adjacent_to_any(index, [spread_indices where tiles[spread_indices] == Tile.Empty])
    for index in [1 ..= @count(tiles)]
];
let spread_reveal_indices: [int] = [[1 ..= @count(tiles)] where is_spread_reveal_tile];

action tick(dt: real) {
    if @count(spread_indices) > 0 then {
        action update_tile_states({
            is_spread_reveal_tile: TileState.Revealed,
            tile_states
        }),
        spread_indices := [[1 ..= @count(tiles)] where is_spread_reveal_tile && tiles == Tile.Empty],
    }
    elif single_click_index >= 1 && double_click_time_left == 0 then {
        action flag(single_click_index),
        single_click_index := 0,
    }
    elif mode == Mode.Initial then {
        action reset(),
    }
    elif mode == Mode.Loss || mode == Mode.Win then {
        end_anim_timer := end_anim_timer + dt / 1000,
    },
    double_click_time_left := @max(0, double_click_time_left - dt / 1000),
    tile_particle_origin := @join(
        [tile_particle_origin where tile_particle_time < particle_max_time],
        grid[spread_reveal_indices],
    ),
    tile_particle_random := @join(
        [tile_particle_random where tile_particle_time < particle_max_time],
        (@random(@count(spread_reveal_indices)), @random(@count(spread_reveal_indices)))
    ),
    tile_particle_time := @join(
        [tile_particle_time where tile_particle_time < particle_max_time] + dt / 1000,
        [0; @count(spread_reveal_indices)],
    ),
    tile_particle_color := @join(
        [tile_particle_color where tile_particle_time < particle_max_time],
        tile_colors[spread_reveal_indices],
    ),
    flag_particle_origin := [flag_particle_origin where flag_particle_time < particle_max_time],
    flag_particle_random := [flag_particle_random where flag_particle_time < particle_max_time],
    flag_particle_time := [flag_particle_time where flag_particle_time < particle_max_time] + dt / 1000,
}

action reveal(index: int) {
    last_revealed_index := index,
    if mode == Mode.Initial then {
        mode := Mode.Play,
        tile_states := set_item(tile_states, index, TileState.Revealed),
        tiles := populate_tiles(insert_item(
            @shuffle({
                [1 ..< @count(tiles)] <= mine_count: Tile.Mine,
                Tile.Empty
            }),
            index,
            Tile.Empty,
        )),
        spread_indices := [index],
    }
    else {
        action update_tile_states(set_item(tile_states, index, TileState.Revealed)),
        if tiles[index] == Tile.Empty then {
            spread_indices := @join(spread_indices, index),
        }
        elif tiles[index] == Tile.Mine then {
            mode := Mode.Loss,
            end_anim_timer := 0,
            explosion_effect_values := @random(@count(explosion_effect_values)),
        },
    },
    tile_particle_origin := @join(tile_particle_origin, grid[index]),
    tile_particle_random := @join(tile_particle_random, (@random(), @random())),
    tile_particle_time := @join(tile_particle_time, 0),
    tile_particle_color := @join(tile_particle_color, tile_colors[index]),
}

action flag(index: int) {
    action update_tile_states(set_item(tile_states, index, TileState.Flagged)),
}

action unflag(index: int) {
    tile_states := set_item(tile_states, index, TileState.Hidden),
    flag_particle_origin := @join(flag_particle_origin, grid[index]),
    flag_particle_random := @join(flag_particle_random, (@random(), @random())),
    flag_particle_time := @join(flag_particle_time, 0),
}

action single_click(index: int) {
    if single_click_index >= 1 then {
        // We don't need to check for a win condition since this action can only be run if the player clicked on
        // another hidden tile, and a solved board can't have any hidden tiles.
        tile_states := set_item(tile_states, single_click_index, TileState.Flagged),
    },
    single_click_index := index,
    double_click_time_left := double_click_max_delay,
}

action double_click() {
    action reveal(single_click_index),
    single_click_index := 0,
    double_click_time_left := 0,
}

action solve() {
    if mode == Mode.Initial then disable
    else {
        tile_states := {
            tiles == Tile.Mine: TileState.Flagged,
            TileState.Revealed
        },
        mode := Mode.Cheated,
    },
}

// Public interface

public {
    "Minesweeper: Desmos Edition";
    "Created by Sean Clarke (@xarkenz)";
    folder "About this graph..." {
        @concat(
            "Fun fact: I made this graph using a compiler which I also created called Desmosify! ",
            "The source code for this graph can be found at https://github.com/xarkenz/desmosify/blob/main/tests/minesweeper/main.desmos.\n\n",
            "This is partially an old graph (the original is at https://www.desmos.com/calculator/af4c011ad9). ",
            "However, once I rewrote it in Desmosify, I went through a lot of iterations to improve it and remake parts of it. ",
            "So, is it really an old graph? I suppose that's for you to decide.\n\n",
            "There were a few difficult parts with this game: board generation, revealing empty space, and control schemes, to name a few. ",
            "Below are some details on the specifics of each of those:\n\n",
            "The first tile you reveal will never be a mine since the board is generated in that moment, and that generation shuffles the mines in all tiles except the one you reveal.\n\n",
            "Revealing empty space is tricky to do in a performant way, and I would know—if you check out my old graph, this aspect is very slow. ",
            "In the old version, every tile is checked on every tick to see whether it should be auto-revealed. ",
            "This version keeps a list of tiles to check instead; if the list is empty, nothing gets checked.\n\n",
            "The most frustrating problem, in my opinion, is the control scheme. ",
            "My original solution, which I've kept around, is to divide each tile into halves for left and right clicking, but that's not mobile-friendly, so I developed a single-click/double-click alternative. ",
            "Double-clicking is annoying, though, since it often lags and drop the second click if it's too soon. Oh well. ",
            "There's also the issue that you can't use touch controls like pinching and dragging to control the viewport on mobile if your finger starts on a clickable object, so I developed a separate mode to get around that.",
        );
    }

    "Firstly, you'll want to pick a control scheme using this slider:\n\n0 (halves) - Better suited for playing with a mouse. Click the left half of a tile to reveal it, the right half to flag it. Clicking a flag removes the flag without revealing the space.\n\n1 (double-click) - Better suited for playing on a touchscreen. Tap once on a tile to flag it, or twice to reveal it. Tapping a flag removes the flag without revealing the space.";
    slider control_scheme;
    "Once you have decided on a control scheme, select a board below and reveal a tile to start the game.";
    "Also, undo and redo work as you would expect, so if you explode and are a dirty cheater you can pretend it never happened.";

    "";
    "Select a difficulty preset, or create a custom board.";
    action easy_preset();
    action medium_preset();
    action hard_preset();
    folder "Custom board..." {
        "Board size:";
        slider board_width;
        slider board_height;
        "Number of mines hidden in the board:";
        slider mine_count;
    }

    "";
    "Slide this to 1 to make it easier to zoom and move the view around.";
    slider view_mode;
    "Use this action to start over with a new board.";
    action reset();
    "Use this action to forfeit and show the solution.";
    action solve();

    "";
    folder "Configuration options..." {
        "Maximum delay between the first and second click in a double click, in seconds:";
        slider double_click_max_delay;
        "Padding between the board and the edge of the graph, in units:";
        slider border_units;
    }
}

// Display/interface

var single_click_index: int = 0;
var double_click_time_left: real = 0;
let interactions_active: bool = !view_mode && @count(spread_indices) == 0;

let background_color: color = @hsv(155, 0.9, 0.55);
let grass_colors: [color] = @hsv([145, 140], [0.8, 0.75], [0.75, 0.8]);
let dirt_colors: [color] = @hsv([30, 33], [0.3, 0.275], [0.875, 0.9]);
let mark_colors: [color] = @hsv([7, 10], [0.7, 0.65], [0.875, 0.9]);

let tile_colors: [color] =
    let i = (grid.x + grid.y) % 2 + 1 in
    {
        tile_states == TileState.Hidden: grass_colors[i],
        tile_states == TileState.Revealed: {tiles == Tile.Mine: mark_colors[i], dirt_colors[i]},
        tile_states == TileState.Flagged: {
            mode == Mode.Win: @okhsv((end_anim_timer * 90 + (grid.y - grid.x) * 18) % 360, 0.6, 1),
            mark_colors[i]
        },
    };

let pixels_to_units: real = 20 / @width_pixels;
let width_units: real = 20 - 2 * border_units;
let height_units: real = 20 * (@height_pixels / @width_pixels) - 2 * border_units;
let board_scale: real = @min(width_units / current_width, height_units / current_height);

let view(point: (real, real)+): (real, real)+ =
    board_scale * ((current_width, current_height) / -2 + point + (0.5, 0.5));

let particle_max_time: real = 1;

// TODO: this would be a prime usage of structs
var tile_particle_origin: [(int, int)] = [];
var tile_particle_random: [(real, real)] = [];
var tile_particle_time: [real] = [];
var tile_particle_color: [color] = [];

var flag_particle_origin: [(int, int)] = [];
var flag_particle_random: [(real, real)] = [];
var flag_particle_time: [real] = [];

let particle_pos(origin: (real, real)+, random: (real, real)+, time: real+): (real, real)+ = origin + time * (
    5 * (random.x - 0.5),
    2 * random.y - 3 * time,
);
let particle_angle(random: (real, real)+, time: real+): real+ = time * (0.5 - random.x) * @tau;

let tile_particle_pos: [(real, real)] = particle_pos(tile_particle_origin, tile_particle_random, tile_particle_time);
let flag_particle_pos: [(real, real)] = particle_pos(flag_particle_origin, flag_particle_random, flag_particle_time);
let tile_particle_angle: [real] = particle_angle(tile_particle_random, tile_particle_time);
let flag_particle_angle: [real] = particle_angle(flag_particle_random, flag_particle_time);

let square_points(to_corner: (real, real)): [(real, real)] = [
    to_corner,
    (-to_corner.y, to_corner.x),
    -to_corner,
    (to_corner.y, -to_corner.x),
];

var last_revealed_index: int = 0;
var end_anim_timer: real = 0;
var explosion_effect_values: [real] = [0; 20];

let explosion_effect: [(real, real)] = [
    (0.75 + 0.3 * (explosion_effect_values[i] + 0.5) * (-1) ** i) *
        let theta = (i / @count(explosion_effect_values)) * @tau in (@cos(theta), @sin(theta))
    for i in [1 ..= @count(explosion_effect_values)]
];
let end_popup_opacity: real = @min(1, {
    mode == Mode.Win: end_anim_timer,
    mode == Mode.Loss: end_anim_timer - 2,
    0
});

display {
    // Background
    @rect((-100, -100), (100, 100)):
        color(background_color),
        fill(1);

    // Board
    @rect(view(grid - (0.5, 0.5)), view(grid + (0.5, 0.5))):
        color(tile_colors),
        line(1, 0.5),
        fill(1);

    // Board debugging
    // view(grid): color(0), label(@concat("${", @target_symbol(tiles), "}"));

    // Tiles
    @image(
        @include_data("images/flag.png"),
        "Flag tile",
        {tile_states == TileState.Flagged: view(grid)},
        0.8 * board_scale, 0.8 * board_scale,
        {mode != Mode.Loss && mode != Mode.Win: 1, tiles == Tile.Mine: 0, 0.5},
    );
    @image(
        @include_data("images/mine.png"),
        "Mine tile",
        {tiles == Tile.Mine &&
            (tile_states == TileState.Hidden || tile_states == TileState.Flagged) &&
            (mode == Mode.Loss || mode == Mode.Win): view(grid)},
        0.8 * board_scale, 0.8 * board_scale,
        end_anim_timer - 1,
    );
    @image(
        @include_data("images/explosion.png"),
        "Explosion tile",
        {tiles == Tile.Mine && tile_states == TileState.Revealed: view(grid)},
        1.2 * board_scale, 1.2 * board_scale,
    );
    @image(
        @include_data("images/one.png"),
        "Tile 1",
        {tiles == Tile.One && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/two.png"),
        "Tile 2",
        {tiles == Tile.Two && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/three.png"),
        "Tile 3",
        {tiles == Tile.Three && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/four.png"),
        "Tile 4",
        {tiles == Tile.Four && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/five.png"),
        "Tile 5",
        {tiles == Tile.Five && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/six.png"),
        "Tile 6",
        {tiles == Tile.Six && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/seven.png"),
        "Tile 7",
        {tiles == Tile.Seven && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );
    @image(
        @include_data("images/eight.png"),
        "Tile 8",
        {tiles == Tile.Eight && tile_states == TileState.Revealed: view(grid)},
        0.7 * board_scale, 0.7 * board_scale,
    );

    // Particles
    [@polygon(view(tile_particle_pos[index] + square_points(
        (@sqrt(2) / 2) * (@cos(@pi / 4 + tile_particle_angle[index]), @sin(@pi / 4 + tile_particle_angle[index]))
    ))) for index in [1 ..= @count(tile_particle_pos)]]:
        color(tile_particle_color),
        fill(1 - tile_particle_time / particle_max_time);
    @image(
        @include_data("images/flag.png"),
        "Flag particle",
        view(flag_particle_pos),
        0.8 * board_scale, 0.8 * board_scale,
        1 - flag_particle_time / particle_max_time,
        flag_particle_angle,
    );

    // Interactions
    @image(
        @transparent_image_data,
        "Reveal tile interaction - Halves only",
        {interactions_active && control_scheme == ControlScheme.Halves && (mode == Mode.Initial || mode == Mode.Play) && tile_states == TileState.Hidden: view(grid)},
        board_scale, board_scale,
        0.6,
    ):
        hovered(@include_data("images/hover_reveal.png")),
        pressed(@include_data("images/hover_reveal.png")),
        click(action reveal);
    @image(
        @transparent_image_data,
        "Flag tile interaction - Halves only",
        {interactions_active && control_scheme == ControlScheme.Halves && (mode == Mode.Initial || mode == Mode.Play) && tile_states == TileState.Hidden: view(grid + (0.25, 0))},
        0.5 * board_scale, board_scale,
    ):
        hovered(@include_data("images/hover_flag.png")),
        pressed(@include_data("images/hover_flag.png")),
        click(action flag);
    @image(
        @transparent_image_data,
        "Single click interaction - DoubleClick only",
        {interactions_active && control_scheme == ControlScheme.DoubleClick && (mode == Mode.Initial || mode == Mode.Play) && tile_states == TileState.Hidden: view(grid)},
        board_scale, board_scale,
    ): click(action single_click);
    @image(
        @transparent_image_data,
        "Unflag tile interaction - Halves and DoubleClick",
        {interactions_active && (mode == Mode.Initial || mode == Mode.Play) && tile_states == TileState.Flagged: view(grid)},
        board_scale, board_scale,
    ): click(action unflag);
    /// Double click interaction - DoubleClick only
    @rect(view(grid[single_click_index] - (0.5, 0.5)), view(grid[single_click_index] + (0.5, 0.5))):
        color(@white),
        line(double_click_time_left / double_click_max_delay, 2),
        fill(0.6 * (double_click_time_left / double_click_max_delay)),
        click(action double_click);

    // Explosion effect
    @polygon({mode == Mode.Loss: view(grid[last_revealed_index]) + 20 * (@cbrt(end_anim_timer + 1) - 1) * explosion_effect}):
        color(@white),
        fill(1 - 0.25 * end_anim_timer);
    @polygon({mode == Mode.Loss: view(grid[last_revealed_index]) + 15 * @max(0, @cbrt(end_anim_timer + 0.7) - 1) * explosion_effect}):
        color(mark_colors[2]),
        fill(1 - 0.25 * end_anim_timer);

    // Popup panel
    @polygon({
        mode == Mode.Loss || mode == Mode.Win: [
            (-300, -100),
            (-250, 100),
            (300, 100),
            (250, -100),
        ] * pixels_to_units
    }): color(@white), fill(0.8 * end_popup_opacity);

    // Messages
    {mode == Mode.Loss: (0, 0)}:
        color(mark_colors[1]),
        label("`Game\\ over...`", end_popup_opacity, 3, 0, "above", false);
    {mode == Mode.Win: (0, 0)}:
        color(grass_colors[1]),
        label("`Congratulations!`", end_popup_opacity, 3, 0, "above", false);
    {mode == Mode.Loss || mode == Mode.Win: (0, -50) * pixels_to_units}:
        color(@black),
        label(@concat("Click here or run `", @target_symbol(action reset), "` to start over."), end_popup_opacity, 1, 0, "center", false),
        click(action reset);
}
