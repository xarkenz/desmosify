enum E { A, B, C }
let my_global: int = 0;
action my_action() {}

public {
    "Trigonometry";

    @pi;
    @tau;

    @sin(@pi / 2);
    @cos(@pi / 2);
    @tan(@pi);
    @csc(0);
    @sec(0);
    @cot(0);
    @arcsin(0);
    @arccos(0);
    @arctan(0);
    @arccsc(0);
    @arcsec(0);
    @arccot(0);
    @sinh(0);
    @cosh(0);
    @tanh(0);
    @csch(0);
    @sech(0);
    @coth(0);

    @arctan2(0, 1);
    @arctan2(0, -1);
    @arctan2(-5, 0);
    @arctan2(0, 0);

    "Number Theory";

    @e;

    @exp(2);
    @ln(@e);
    @log(@e, @e);

    @lcm(4, 7);
    @lcm(4, 6);
    @lcm([1 ..= 5]);
    @lcm([]);

    @gcd(4, 7);
    @gcd(4, 6);
    @gcd([6, 9, 24]);
    @gcd([]);

    @ceil(1.0);
    @ceil([1.1, 1.5, 1.7]);
    @ceil(-1.5);

    @floor(1.0);
    @floor([1.1, 1.5, 1.7]);
    @floor(-1.5);

    @round(1.0);
    @round([1.1, 1.5, 1.7]);
    @round(-1.5);

    @round_digits(@pi, 2);
    @round_digits(@pi, 0);
    @round_digits(5678.9, -2);

    @abs(5);
    @abs(-5);
    @abs(0);

    @sign(12.3);
    @sign(-12.3);
    @sign(0.0);

    @sqrt(4);
    @cbrt(8);
    @nth_root(16, 4);

    "Complex";

    "List Operations";

    @join([1, 2], [3], 4);

    @sort([3, 1, 4, 2]);
    -@sort(-[3, 1, 4, 2]);
    @sort([(0,0), (1,1), (2,2)], [3, 1, 2]);
    @sort([(0,0), (1,1), (2,2)], -[3, 1, 2]);

    @shuffle([1 ..= 4]);

    @unique([1, 4, 1, 3, 3, 2, 3, 4]);

    @prefix_sum([]);
    @prefix_sum([1, 2, 3]);
    @prefix_sum([3, 2, 1]);

    "Statistics";

    @mean(3, 1, 5, 2);
    @mean([3, 1, 5, 2]);
    @mean([]);

    @median(3, 1, 5);
    @median(3, 1, 5, 2);
    @median([3, 1, 5, 2]);
    @median([]);

    @min(3, 1, 4, 2);
    @min([3, 1, 4, 2]);
    @min([]);

    @max(3, 1, 4, 2);
    @max([3, 1, 4, 2]);
    @max([]);

    @count(1, 2, 3);
    @count([1 ..= 10]);
    @count([]);

    @total(1, 2, 3);
    @total([1 ..= 5]);
    @total([]);

    @any(false, true, false);
    @any(false, false, false);
    @any([1 ..= 10] == 7);
    @any([1 ..= 10] == 11);
    @any([]);

    @all(true, true, true);
    @all(true, false, true);
    @all([1 ..= 10] < 11);
    @all([1 ..= 10] < 7);
    @all([]);

    @random();
    @random(2);

    @choose_random([1 ..= 10]);
    @choose_random([1 ..= 10], 3);

    "Statistical Tests";

    "Geometry";

    @polygon([]);
    @polygon((0,0), (1,1));

    @rect((0,0), (1,1));

    "Properties & Measurements";

    @midpoint((0,0), (1,1));
    @midpoint((0,0,0), (1,1,1));

    "Transformations";

    "Color";

    "Sound";

    "Advanced";

    @width_pixels;
    @height_pixels;

    "Desmosify";

    @bool_to_internal(true);
    @bool_to_internal(false);

    @bool_from_internal(@bool_to_internal(true));
    @bool_from_internal(@bool_to_internal(false));

    @enum_values(E);

    @enum_value(E, 1);

    @concat("Hello", " ", "world", "!");

    @target;

    @target_symbol(my_global);
    @target_symbol(action my_action);
}
